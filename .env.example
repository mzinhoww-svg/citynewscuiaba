# Copie para .env.local. Nunca commite valores reais.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=substituir
SUPABASE_SERVICE_ROLE_KEY=substituir
# Conexão direta ao Postgres (db:types, db:seed:sources). Local: DB_URL de `supabase status`.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
CRON_SECRET=substituir-por-32-caracteres-aleatorios
AI_PROVIDER=fake                     # fake | openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
CRAWLER_USER_AGENT="CityNewsBot/1.0 (+https://citynewscuiaba.vercel.app/sobre#robo)"
# Cópias de imagem: Supabase Storage (bucket media). Só na pilha local sem Storage: MEDIA_STORE=memory
MEDIA_STORE=
# Ainda não lida pelo código (auditoria 360, P2-OBS): reservada para rastreio de erros.
SENTRY_DSN=
# Google OAuth e SMTP ficam configurados no painel do Supabase Auth (não aqui).
# Depois de ligar o provedor Google no Auth, AUTH_GOOGLE_ENABLED=1 mostra "Entrar com Google" (B-006).
AUTH_GOOGLE_ENABLED=
# Web Push (PWA, spec 2026-09-28 §17): gere o par uma vez com `pnpm push:keys` e guarde na Vercel.
# Sem as três, o push degrada (D-P25): o portal não oferece avisos e A09 mostra o que falta.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
PUSH_PROVIDER=fake                   # fake | webpush
# Só em teste: hosts de push extras (127.0.0.1:<porta>); ignorada em produção.
PUSH_ENDPOINT_TEST_HOSTS=
# Sal diário do hash de IP do limite de envios. Sem ele cai no CRON_SECRET; sem nenhum, em
# produção os formulários falham fechado (src/lib/security/rate-limit.ts).
RATE_LIMIT_SALT=
# Assinatura dos links da newsletter. Sem ele cai no CRON_SECRET (src/lib/newsletter/token.ts).
NEWSLETTER_TOKEN_SECRET=
# Guia Cuiabá (R38): chave da Content API do TripAdvisor só no ambiente; sem ela, pesquisa web (R33).
TRIPADVISOR_API_KEY=
GUIDE_TA_DAILY_CALLS=
# Só para teste: CN_SHOW_DS=1 abre o design system em produção; CN_SHOW_LEGAL_PAGES=1 abre as
# páginas legais ocultas pela R34 (/como-usamos-ia, /metodologia).
CN_SHOW_DS=
CN_SHOW_LEGAL_PAGES=
