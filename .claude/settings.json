{
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep", "WebFetch", "WebSearch", "Task", "TodoWrite",
      "Bash(pnpm:*)", "Bash(npx:*)", "Bash(node:*)", "Bash(git:*)", "Bash(gh:*)",
      "Bash(vercel:*)", "Bash(supabase:*)", "Bash(docker:*)", "Bash(agent-browser:*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(mkdir:*)", "Bash(cp:*)", "Bash(mv:*)", "Bash(touch:*)",
      "Bash(grep:*)", "Bash(find:*)", "Bash(jq:*)", "Bash(curl:*)", "Bash(sed:*)", "Bash(head:*)", "Bash(tail:*)",
      "Bash(rm -rf node_modules:*)", "Bash(rm -rf .next:*)", "Bash(rm -rf playwright-report:*)", "Bash(rm -rf test-results:*)",
      "mcp__Vercel", "mcp__Supabase"
    ],
    "ask": [
      "mcp__Vercel__buy_domain", "mcp__Vercel__buy_domains", "mcp__Vercel__buy_single_domain",
      "mcp__Vercel__create_or_transfer_domain", "mcp__Vercel__create_project", "mcp__Vercel__pause_project",
      "mcp__Supabase__create_project", "mcp__Supabase__pause_project", "mcp__Supabase__restore_project",
      "mcp__Supabase__create_branch", "mcp__Supabase__delete_branch", "mcp__Supabase__merge_branch",
      "mcp__Supabase__reset_branch"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard origin:*)",
      "Bash(rm -rf /:*)", "Bash(rm -rf ~:*)", "Bash(sudo:*)",
      "Bash(supabase db reset --linked:*)", "Bash(supabase projects delete:*)",
      "Bash(vercel remove:*)", "Bash(vercel domains buy:*)", "Bash(gh repo delete:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "cat .planning/STATE.md 2>/dev/null; node scripts/next-task.mjs 2>/dev/null || true" }
        ]
      }
    ]
  }
}
