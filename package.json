{
  "name": "citynewscuiaba",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "pnpm sw:build && next dev",
    "build": "pnpm sw:build && next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p src/sw",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:start": "bash scripts/local-stack/start.sh",
    "db:reset": "node scripts/db-reset.mjs",
    "db:types": "npx -y supabase@2.118.0 gen types typescript --db-url \"${SUPABASE_DB_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" --schema public > src/lib/db/types.ts && prettier --write src/lib/db/types.ts",
    "db:seed:guide": "node scripts/seed-guide-fixtures.mjs",
    "db:seed:sources": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/seed_sources_real.sql",
    "design:detect": "impeccable detect src/components \"src/app/(public)\" src/styles",
    "design:shoot": "node scripts/shoot-public.mjs",
    "sw:build": "node scripts/build-sw.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "icons:sprite": "node scripts/build-icon-sprite.mjs",
    "push:keys": "web-push generate-vapid-keys --json"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@mozilla/readability": "^0.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "ai": "^7.0.118",
    "esbuild": "0.25.10",
    "fast-xml-parser": "^5.11.1",
    "idb-keyval": "^6.3.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@next/env": "^16.3.6",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "impeccable": "^4.1.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  }
}
