{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/discovery/**",
              "components/forms/**",
              "components/icons/**",
              "components/lists/**",
              "components/navigation/**",
              "components/news/**",
              "components/overlays/**",
              "ui_kits/app/**",
              "ui_kits/web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Schibsted Grotesk|Source Serif 4))/i]",
        "message": "Font not provided by the design system. Available: Schibsted Grotesk, Source Serif 4."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgendaItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:when|title|place|key|ref|className|style|children)$/]",
        "message": "<AgendaItem> doesn't accept that prop. Declared props: when, title, place."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleActionBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:likes|comments|liked|saved|progress|onLike|onComment|onShare|onSave|style|key|ref|className|style|children)$/]",
        "message": "<ArticleActionBar> doesn't accept that prop. Declared props: likes, comments, liked, saved, progress, onLike, onComment, onShare, onSave, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:values|labels|height|highlight|style|key|ref|className|style|children)$/]",
        "message": "<BarChart> doesn't accept that prop. Declared props: values, labels, height, highlight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|footer|onClose|inline|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: open, title, children, footer, onClose, inline."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|leading|fullWidth|disabled|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, leading, fullWidth, disabled, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline|outline-strong|accent|text|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'outline' | 'outline-strong' | 'accent' | 'text' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|tone|key|ref|className|style|children)$/]",
        "message": "<CategoryTag> doesn't accept that prop. Declared props: children, variant, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:text|pill|label)$/]",
        "message": "<CategoryTag> variant must be one of 'text' | 'pill' | 'label'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:news|service)$/]",
        "message": "<CategoryTag> tone must be one of 'news' | 'service'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onClick|children|tone|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: active, onClick, children, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Chip> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|actions|onClose|inline|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, children, actions, onClose, inline."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|image|category|time|comments|width|height|onClick|style|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: title, image, category, time, comments, width, height, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|fill|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, fill, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|variant|size|badge|label|iconColor|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, variant, size, badge, label, iconColor, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|filled|inverse|ghost)$/]",
        "message": "<IconButton> variant must be one of 'outline' | 'filled' | 'inverse' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|leading|label|value|trailing|selected|danger|bordered|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: icon, leading, label, value, trailing, selected, danger, bordered, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiveIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|pulse|inverse|key|ref|className|style|children)$/]",
        "message": "<LiveIndicator> doesn't accept that prop. Declared props: label, pulse, inverse."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|base|alt|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, height, base, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:horizontal|horizontal-negative|horizontal-mono|vertical-negative|symbol)$/]",
        "message": "<Logo> variant must be one of 'horizontal' | 'horizontal-negative' | 'horizontal-mono' | 'vertical-negative' | 'symbol'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:author|avatar|time|comments|category|trending|onMore|inverse|style|key|ref|className|style|children)$/]",
        "message": "<MetaRow> doesn't accept that prop. Declared props: author, avatar, time, comments, category, trending, onMore, inverse, style."
